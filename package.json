{
  "name": "stock-trading-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.0.0", "npm": ">=11.0.0" },
  "scripts": {
    "dev": "npm run build --workspace @stock-trading/shared && run-p dev:server dev:web",
    "dev:server": "npm run dev --workspace @stock-trading/server",
    "dev:web": "npm run dev --workspace @stock-trading/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration",
    "build": "npm run build --workspace @stock-trading/shared && npm run build --workspace @stock-trading/server && npm run build --workspace @stock-trading/web",
    "start": "npm run start --workspace @stock-trading/server",
    "test:production": "vitest run --config vitest.production.config.ts",
    "test:container-smoke": "node scripts/container-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "1.63.0",
    "@types/node": "latest",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "latest",
    "jsdom": "29.1.1",
    "npm-run-all2": "8.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vitest": "5.0.2"
  }
}
